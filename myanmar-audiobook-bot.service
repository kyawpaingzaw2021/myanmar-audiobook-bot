[Unit]
Description=Myanmar Audiobook Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kyawpaing
Group=kyawpaing
WorkingDirectory=/home/kyawpaing/myanmar-audiobook-bot
ExecStart=/home/kyawpaing/myanmar-audiobook-bot/venv/bin/python /home/kyawpaing/myanmar-audiobook-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=null
StandardError=null
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
